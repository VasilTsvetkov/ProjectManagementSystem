@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12 mb-4">
            <h1 class="fw-bold h2 mb-1">Account Settings</h1>
            <p class="text-muted small">Manage your profile, credentials, and security data.</p>
            <hr class="opacity-10" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}