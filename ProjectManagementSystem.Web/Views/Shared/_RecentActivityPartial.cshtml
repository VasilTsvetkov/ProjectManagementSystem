@model List<ActivityDto>

<div class="card shadow-sm mb-4 border-0">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="m-0 fw-bold text-primary">
            <i class="bi bi-activity me-2"></i>Recent Activity
        </h6>
    </div>
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted small">
                    <i class="bi bi-inbox display-6 d-block mb-2 opacity-50"></i>
                    No recent activity to show.
                </div>
            }
            else
            {
                @foreach (var activity in Model)
                {
                    var (icon, color) = activity.Type switch
                    {
                        ActivityType.TaskAction => ("bi-plus-circle-fill", "text-success"),
                        ActivityType.CommentAction => ("bi-chat-dots-fill", "text-info"),
                        ActivityType.ProjectAction => ("bi-arrow-repeat", "text-warning"),
                        _ => ("bi-info-circle-fill", "text-secondary")
                    };

                    <div class="list-group-item border-0 border-bottom px-3 py-3">
                        <div class="d-flex align-items-start">
                            <div class="me-3 mt-1">
                                <i class="bi @icon @color fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-0 text-dark small fw-medium">@activity.Message</p>
                                <small class="text-muted d-flex align-items-center mt-1" style="font-size: 0.75rem;">
                                    <i class="bi bi-clock me-1"></i>
                                    @activity.Timestamp.ToString(TimeConfig.DateTimeDisplayFormat)
                                </small>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>