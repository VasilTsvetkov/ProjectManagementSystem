@model ErrorViewModel
@{
    ViewData["Title"] = "Error " + (Model.StatusCode?.ToString() ?? "");
    var status = Model.StatusCode ?? 500;

    var (icon, title, message) = status switch
    {
        404 => ("bi-search", "Page Not Found", "The page you're looking for does not exist."),
        403 => ("bi-shield-lock", "Access Denied", "You do not have permission to access this resource."),
        401 => ("bi-key", "Unauthorized", "Please log in to continue."),
        _ => ("bi-exclamation-triangle", "System Error", "An unexpected error occurred on our end.")
    };
}

<div class="container py-5 text-center">
    <div class="display-1 text-primary mb-4">
        <i class="bi @icon"></i>
    </div>
    <h1 class="fw-bold text-dark">@status</h1>
    <h2 class="h4 text-muted mb-4">@title</h2>
    <p class="lead mb-5">@message</p>

    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-house-door me-2"></i>Home
        </a>
        <button onclick="history.back()" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>Back
        </button>
    </div>

    @if (Model.ShowRequestId)
    {
        <div class="mt-5 pt-4 border-top">
            <small class="text-muted">ID: @Model.RequestId</small>
        </div>
    }
</div>