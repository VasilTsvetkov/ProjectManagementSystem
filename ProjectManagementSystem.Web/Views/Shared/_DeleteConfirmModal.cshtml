<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow delete-modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p id="deleteModalMessage" class="mb-0 delete-modal-text">Are you sure you want to delete this item?</p>
                <p class="delete-modal-subtext small mt-2">This action is permanent and cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 delete-modal-footer">
                <button type="button" class="btn btn-cancel border" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .delete-modal-content {
        background-color: #ffffff;
    }

    .delete-modal-text {
        color: #212529;
    }

    .delete-modal-subtext {
        color: #6c757d;
    }

    .btn-cancel {
        background-color: #f8f9fa;
        color: #212529;
        border-color: #dee2e6 !important;
    }

    [data-theme="dark"] .delete-modal-content {
        background-color: #1e1e1e;
        border: 1px solid #333333 !important;
    }

    [data-theme="dark"] .delete-modal-text {
        color: #f8f9fa !important;
    }

    [data-theme="dark"] .delete-modal-subtext {
        color: #a0a0a0 !important;
    }

    [data-theme="dark"] .btn-cancel {
        background-color: #2b2b2b;
        color: #e0e0e0;
        border-color: #444444 !important;
    }
</style>