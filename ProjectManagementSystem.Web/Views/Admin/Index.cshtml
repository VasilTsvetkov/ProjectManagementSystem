@model IEnumerable<UserRoleViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div id="antiforgery-container" class="d-none">
    @Html.AntiForgeryToken()
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill me-2"></i>User Management</h2>
        <span class="badge bg-secondary">Total Users: @Model.Count()</span>
    </div>

    @if (TempData[NotificationKeys.Success] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData[NotificationKeys.Success]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData[NotificationKeys.Error] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData[NotificationKeys.Error]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Full Name</th>
                        <th>Email</th>
                        <th>Current Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@user.FullName</div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.IsAdmin)
                                {
                                    <span class="badge rounded-pill bg-danger">@user.CurrentRole</span>
                                }
                                else if (user.CurrentRole == Roles.Manager)
                                {
                                    <span class="badge rounded-pill bg-warning text-dark">@user.CurrentRole</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-info text-dark">@user.CurrentRole</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (user.IsAdmin)
                                {
                                    <small class="text-muted italic">System Administrator</small>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm w-auto d-inline-block"
                                            data-user-id="@user.UserId"
                                            onchange="updateUserRole(this)">
                                        <option value="@Roles.Member" selected="@(user.CurrentRole == Roles.Member)">Member</option>
                                        <option value="@Roles.Manager" selected="@(user.CurrentRole == Roles.Manager)">Manager</option>
                                    </select>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateUserRole(selectElement) {
            const userId = selectElement.getAttribute("data-user-id");
            const newRole = selectElement.value;
            const row = selectElement.closest("tr");
            const badgeContainer = row.querySelector("td:nth-child(3)");
            const originalBadgeHtml = badgeContainer.innerHTML;

            const token = document.querySelector('#antiforgery-container input[name="__RequestVerificationToken"]').value;

            badgeContainer.innerHTML = `<span class="badge rounded-pill bg-secondary opacity-75">Updating...</span>`;

            fetch(`/admin/users/ChangeRole?userId=${userId}&newRole=${newRole}`, {
                method: 'POST',
                headers: {
                    'X-XSRF-TOKEN': token
                }
            })
                .then(response => {
                    if (response.ok) {
                        if (newRole === "Manager") {
                            badgeContainer.innerHTML = `<span class="badge rounded-pill bg-warning text-dark">Manager</span>`;
                        } else {
                            badgeContainer.innerHTML = `<span class="badge rounded-pill bg-info text-dark">Member</span>`;
                        }
                    } else {
                        throw new Error();
                    }
                })
                .catch(() => {
                    badgeContainer.innerHTML = originalBadgeHtml;
                    selectElement.value = selectElement.querySelector('option[selected]').value;
                });
        }
    </script>
}