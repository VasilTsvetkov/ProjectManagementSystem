@model List<ProjectManagementSystem.ViewModels.Home.ActivityDto>
@using ProjectManagementSystem.Enums

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-list-ul me-2"></i>Recent Activity</h6>
    </div>
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">No recent activity to show.</div>
            }
            @foreach (var activity in Model)
            {
                var (icon, color) = activity.Type switch
                {
                    ActivityType.TaskAction => ("fa-plus-circle", "text-success"),
                    ActivityType.CommentAction => ("fa-comment-dots", "text-info"),
                    ActivityType.ProjectAction => ("fa-sync", "text-warning"),
                    _ => ("fa-info-circle", "text-secondary")
                };

                <div class="list-group-item border-0 border-bottom px-3 py-3">
                    <div class="d-flex align-items-start">
                        <div class="me-3">
                            <i class="fas @icon @color fa-lg"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p class="mb-0 text-dark">@activity.Message</p>
                            <small class="text-muted"><i class="far fa-clock me-1"></i>@activity.Timestamp.ToString("MMM dd, HH:mm")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>