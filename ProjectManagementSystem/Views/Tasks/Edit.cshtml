@model EditTaskViewModel

@{
    ViewData["Title"] = "Edit Task";
    var projectId = ViewBag.ProjectId;
    var taskId = ViewContext.RouteData.Values["id"];
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-route-projectId="@projectId" class="text-decoration-none">Tasks</a></li>
                    <li class="breadcrumb-item active">Edit Task</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>Edit Task
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-projectId="@projectId" asp-route-id="@taskId" method="post">

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <input asp-for="Title" class="form-control border-2" placeholder="Task title..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <textarea asp-for="Description" class="form-control border-2" rows="4" placeholder="Description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Type" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <select asp-for="Type" asp-items="Html.GetEnumSelectList<Type>()" class="form-select border-2"></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Priority" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select border-2"></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<Status>()" class="form-select border-2"></select>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Deadline" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <input asp-for="Deadline" type="date" class="form-control border-2" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AssigneeId" class="form-label fw-bold small text-uppercase text-muted">Assignee</label>
                                <select asp-for="AssigneeId" asp-items="Model.Users" class="form-select border-2">
                                    <option value="">-- @MessageConstants.Unassigned --</option>
                                </select>
                                <span asp-validation-for="AssigneeId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" asp-route-projectId="@projectId" class="btn btn-light border px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
</style>