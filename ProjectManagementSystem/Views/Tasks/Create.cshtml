@model TaskViewModel

@{
    ViewData["Title"] = "Create Task";
    var projectId = Context.GetRouteValue("projectId");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index" class="text-decoration-none">Projects</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-route-projectId="@projectId" class="text-decoration-none">Tasks</a></li>
                    <li class="breadcrumb-item active">New Task</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h4 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Create Task
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" asp-route-projectId="@projectId" method="post">
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <input asp-for="Title" class="form-control form-control-lg fs-6" placeholder="Task summary..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the requirements..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Type" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<ProjectManagementSystem.Enums.Task.Type>()" class="form-select"></select>
                                </div>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Priority" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-flag"></i></span>
                                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ProjectManagementSystem.Enums.Task.Priority>()" class="form-select"></select>
                                </div>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Deadline" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="Deadline" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="Deadline" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="AssigneeId" class="form-label fw-bold small text-uppercase text-muted">Assignee</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-plus"></i></span>
                                    <select asp-for="AssigneeId" asp-items="Model.Users" class="form-select">
                                        <option value="">-- Unassigned --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="AssigneeId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-4 mt-2 border-top">
                            <a asp-action="Index" asp-route-projectId="@projectId" class="btn btn-white border px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                Create Task
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}