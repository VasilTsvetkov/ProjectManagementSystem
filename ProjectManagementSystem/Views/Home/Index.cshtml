@model IndexViewModel

@{
    ViewData["Title"] = "My Overview";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-dark fw-bold">My Overview</h1>
            <p class="text-muted mb-0">Welcome back! Here is what's happening with your projects.</p>
        </div>
        <div class="text-end">
            <span class="badge bg-white text-dark border shadow-sm px-3 py-2">
                <i class="bi bi-calendar3 me-2 text-primary"></i>@DateTime.Now.ToString("D")
            </span>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 border-start border-primary border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1 small fw-bold">Pending Tasks</div>
                            <div class="h4 mb-0 fw-bold">@Model.MyPendingTasksCount</div>
                        </div>
                        <i class="bi bi-list-task fs-2 text-light"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 border-start border-danger border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1 small fw-bold">Overdue Tasks</div>
                            <div class="h4 mb-0 fw-bold">@Model.OverdueTasksCount</div>
                        </div>
                        <i class="bi bi-exclamation-octagon fs-2 text-light"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-dark"><i class="bi bi-fire me-2 text-danger"></i>Urgent Tasks</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Tag</th>
                                    <th>Title</th>
                                    <th>Deadline</th>
                                    <th class="pe-3">Priority</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.UrgentTasks.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="bi bi-check2-circle fs-1 d-block mb-2 text-success"></i>
                                            You have no urgent tasks. Great job!
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var task in Model.UrgentTasks)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <a asp-controller="Tasks" asp-action="Details"
                                                   asp-route-projectId="@task.ProjectId"
                                                   asp-route-id="@task.Id"
                                                   class="text-decoration-none">
                                                    <span class="badge bg-light text-dark border">@task.Tag</span>
                                                </a>
                                            </td>
                                            <td><span class="fw-bold">@task.Title</span></td>
                                            <td class="@(task.Deadline < DateTime.UtcNow ? "text-danger fw-bold" : "")">
                                                <i class="bi bi-clock me-1"></i>@task.Deadline?.ToString("MMM dd")
                                            </td>
                                            <td class="pe-3">
                                                @{
                                                    var priorityClass = task.Priority switch
                                                    {
                                                        Priority.Critical => "bg-dark",
                                                        Priority.High => "bg-danger",
                                                        Priority.Medium => "bg-warning text-dark",
                                                        Priority.Low => "bg-info text-white",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @priorityClass rounded-pill">@task.Priority</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-dark"><i class="bi bi-lightning-charge me-2 text-warning"></i>Recent Activity</h6>
                </div>
                <div class="card-body">
                    <partial name="_RecentActivityPartial" model="Model.RecentActivities" />
                </div>
            </div>
        </div>
    </div>
</div>