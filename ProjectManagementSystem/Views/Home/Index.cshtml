@model ProjectManagementSystem.ViewModels.Home.IndexViewModel
@using ProjectManagementSystem.Enums

@{
    ViewData["Title"] = "My Overview";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">My Overview</h1>
            <p class="text-muted mb-0">Welcome back! Here is what's happening with your projects.</p>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-dark border shadow-sm px-3 py-2">
                <i class="far fa-calendar-alt me-2 text-primary"></i>@DateTime.UtcNow.ToString("D")
            </span>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card border-start border-primary border-4 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">My Pending Tasks</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.MyPendingTasksCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tasks fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card border-start border-danger border-4 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Overdue Tasks</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.OverdueTasksCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-fire me-2 text-danger"></i>Urgent Tasks</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tag</th>
                                    <th>Title</th>
                                    <th>Deadline</th>
                                    <th>Priority</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.UrgentTasks.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">You have no urgent tasks. Great job!</td>
                                    </tr>
                                }
                                @foreach (var task in Model.UrgentTasks)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Tasks" asp-action="Details"
                                               asp-route-projectId="@task.ProjectId"
                                               asp-route-id="@task.Id"
                                               class="text-decoration-none">
                                                <span class="badge bg-secondary shadow-sm hover-shadow">@task.Tag</span>
                                            </a>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">@task.Title</span>
                                        </td>
                                        <td class="@(task.Deadline < DateTime.UtcNow ? "text-danger fw-bold" : "")">
                                            <i class="far fa-clock me-1"></i>@task.Deadline?.ToString("MMM dd")
                                        </td>
                                        <td>
                                            @{
                                                var priorityClass = task.Priority switch
                                                {
                                                    TaskPriority.Critical => "bg-dark text-white shadow-sm",
                                                    TaskPriority.High => "bg-danger",
                                                    TaskPriority.Medium => "bg-warning text-dark",
                                                    TaskPriority.Low => "bg-info",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @priorityClass">@task.Priority</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @await Html.PartialAsync("_RecentActivityPartial", Model.RecentActivities)
        </div>
    </div>
</div>