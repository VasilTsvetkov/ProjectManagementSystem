@using ProjectManagementSystem.Helpers
@model ProjectManagementSystem.ViewModels.TimeLogs.MonthlyMatrixViewModel

@{
    ViewData["Title"] = $"{Model.ProjectName} - Time Matrix";
    var prevMonth = Model.SelectedMonth.AddMonths(-1);
    var nextMonth = Model.SelectedMonth.AddMonths(1);
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Model.ProjectName - @Model.SelectedMonth.ToString("MMMM yyyy")</h2>

        <div class="btn-group shadow-sm">
            <a asp-action="Matrix"
               asp-route-projectId="@Model.ProjectId"
               asp-route-month="@prevMonth.Month"
               asp-route-year="@prevMonth.Year"
               class="btn btn-outline-secondary">&laquo; Previous</a>

            <a asp-action="Matrix"
               asp-route-projectId="@Model.ProjectId"
               asp-route-month="@DateTime.Now.Month"
               asp-route-year="@DateTime.Now.Year"
               class="btn btn-outline-primary">Current Month</a>

            <a asp-action="Matrix"
               asp-route-projectId="@Model.ProjectId"
               asp-route-month="@nextMonth.Month"
               asp-route-year="@nextMonth.Year"
               class="btn btn-outline-secondary">Next &raquo;</a>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            @* Sticky User Column Header *@
                            <th style="min-width: 200px; position: sticky; left: 0; z-index: 15; background: #f8f9fa;" class="align-middle">User</th>

                            @foreach (var day in Model.DaysInMonth)
                            {
                                var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                                <th class="text-center @(isWeekend ? "bg-warning-subtle text-danger" : "bg-light")" style="min-width: 50px;">
                                    <small class="d-block opacity-75">@day.ToString("ddd")</small>
                                    <strong>@day.Day</strong>
                                </th>
                            }
                            <th class="text-center bg-dark text-white align-middle" style="min-width: 90px;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @* Sticky User Name Cell *@
                                <td style="position: sticky; left: 0; z-index: 10; background: white; font-weight: 600; border-right: 2px solid #dee2e6;">
                                    @row.FullName
                                </td>

                                @foreach (var day in Model.DaysInMonth)
                                {
                                    var hours = row.DailyHours[day.Day];
                                    var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;

                                    <td class="text-center @(hours > 0 ? "table-primary" : (isWeekend ? "bg-light opacity-50" : ""))">
                                        @if (hours > 0)
                                        {
                                            <span class="fw-bold">@TimeFormatter.Format(hours)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-25">.</span>
                                        }
                                    </td>
                                }

                                <td class="text-center fw-bold bg-light" style="border-left: 2px solid #dee2e6;">
                                    @TimeFormatter.Format(row.TotalHours)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        overflow-x: auto;
    }

    thead th {
        position: sticky;
        top: 0;
        z-index: 11;
        box-shadow: 0 2px 2px -1px rgba(0,0,0,0.1);
    }

    tbody tr:hover {
        background-color: rgba(0,0,0,.02);
    }
</style>