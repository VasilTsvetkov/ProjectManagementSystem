@model IEnumerable<ProjectDisplayViewModel>

@{
    ViewData["Title"] = "Projects";
    bool canManage = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Projects</h2>
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Project
            </a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder2-open display-1 text-muted"></i>
                    <p class="text-muted mt-3">No projects yet. Create your first one!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Tag</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Created At</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <partial name="_ProjectTag" model="@project.Tag" />
                                    </td>
                                    <td class="fw-bold">@project.Name</td>
                                    <td class="text-muted small">@project.Description</td>
                                    <td class="small">@project.CreatedAt.ToString(TimeConfig.DateDisplayFormat)</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-controller="Tasks" asp-action="Index" asp-route-projectId="@project.Id"
                                               class="btn btn-sm btn-outline-primary" title="View Tasks">
                                                <i class="bi bi-list-task"></i> Tasks
                                            </a>
                                            <a asp-controller="TimeLogs" asp-action="Matrix" asp-route-projectId="@project.Id"
                                               class="btn btn-sm btn-outline-info" title="Time Matrix">
                                                <i class="bi bi-grid-3x3"></i> Matrix
                                            </a>

                                            @if (canManage)
                                            {
                                                <a asp-action="Edit" asp-route-id="@project.Id"
                                                   class="btn btn-sm btn-outline-secondary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                                        onclick="confirmDelete('@Url.Action("Delete", "Projects", new { id = project.Id })', '@project.Name')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DeleteConfirmModal" />
}